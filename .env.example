# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_management?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Nodemailer / SMTP Email Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="Multi Tenant Backend <noreply@multitenantbackend.com>"

# JWT (Must be at least 32 characters)
JWT_SECRET=your-32-char-jwt-access-secret-here-12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-32-char-jwt-refresh-secret-here-12345
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Google OAuth Integration (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
TOKEN_ENCRYPTION_KEY=your-32-char-token-encryption-secret-here-12345

# RAG & Embedding Provider Configuration
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=your-openai-or-gemini-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RAG_DEFAULT_TOP_K=5
RAG_MIN_SIMILARITY_THRESHOLD=0.5
RAG_MAX_CONTEXT_LENGTH=12000

# LLM Configuration (Groq, OpenAI, Gemini, or Mock)
LLM_PROVIDER=mock
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# AI & Agent Execution Limits
AI_MAX_STEPS=10
AI_MAX_TOOL_CALLS=5
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048

# Logging
LOG_LEVEL=debug

